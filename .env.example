APP_NAME=Nesiyeh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nesiyeh
DB_USERNAME=nesiyeh
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Development-only OTP provider. Never enable test OTP in production.
OTP_PROVIDER=log
OTP_DEVELOPMENT_CODE_ENABLED=true
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5

# Production SMS credentials belong in deployment secrets, never in Git.
SMS_PROVIDER=
SMS_API_KEY=
